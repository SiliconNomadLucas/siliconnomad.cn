---
import { Image } from 'astro:assets';
import avatar from '../../素材/头像.png';
import douyinQr from '../../素材/抖音二维码.png';
import wechatQr from '../../素材/公众号二维码.jpg';
import {
	siTiktok,
	siWechat,
	siXiaohongshu,
	siBilibili,
	siGithub,
	siYoutube,
	siX,
	siRss,
	siDouban,
} from 'simple-icons';

interface Props {
	title: string;
	description?: string;
	current?: string;
}

const { title, description = '硅基游民 Lucas：保持对这个世界的好奇心。', current = '' } = Astro.props;
const navItems = [
	{ label: '首页', href: '/', key: 'home' },
	{ label: '文章', href: '/articles/', key: 'articles' },
	{ label: '合辑', href: '/collections/', key: 'collections' },
	{ label: '关于', href: '/about/', key: 'about' },
];
const collections = [
	{ label: '好奇心周刊', href: '/collections/curiosity-weekly/' },
	{ label: '碳基思考碎片', href: '/collections/organic-notes/' },
	{ label: '硅基思考碎片', href: '/collections/silicon-notes/' },
	{ label: '周期观察笔记', href: '/collections/periodic-observations/' },
];
const socialLinks = [
	{ label: '抖音', href: 'https://v.douyin.com/70Bihprf1o8/', icon: siTiktok, qr: douyinQr },
	{ label: '微信公众号', icon: siWechat, qr: wechatQr },
	{ label: '小红书', href: 'https://www.xiaohongshu.com/user/profile/604aea730000000001001e83', icon: siXiaohongshu },
	{ label: 'B站', href: 'https://space.bilibili.com/235572105', icon: siBilibili },
	{ label: '豆瓣', href: 'https://www.douban.com/people/SiliconNomad/', icon: siDouban },
	{ label: 'GitHub', href: 'https://github.com/SiliconNomadLucas', icon: siGithub },
	{ label: 'YouTube', href: 'https://www.youtube.com/@SiliconNomadLucas', icon: siYoutube },
	{ label: 'X', href: 'https://x.com/siliconnomadlucas', icon: siX },
	{ label: 'RSS', href: '/rss.xml', icon: siRss },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="硅基游民 Lucas" href="/rss.xml" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="identity" href="/" aria-label="硅基游民 Lucas">
				<Image src={avatar} alt="硅基游民 Lucas 头像" class="avatar" />
				<strong>硅基游民 Lucas</strong>
			</a>
			<nav class="primary-nav" id="primary-nav" aria-label="主导航">
				{navItems.map((item) => (
					item.key === 'collections' ? (
						<div class="collections-dropdown">
							<a href={item.href} class:list={{ active: current === item.key }} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
							<div class="collections-menu">
								{collections.map((collection) => <a href={collection.href}>{collection.label}</a>)}
							</div>
						</div>
					) : (
						<a href={item.href} class:list={{ active: current === item.key }} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
					)
				))}
			</nav>
			<button class="menu-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="primary-nav">
				<span></span><span></span>
			</button>
		</header>
		<slot />
		<footer class="site-footer" id="site-footer">
			<div class="footer-main">
				<a class="identity footer-identity" href="/">
					<Image src={avatar} alt="" class="avatar" />
					<span><strong>硅基游民 Lucas</strong><small>保持对这个世界的好奇心</small></span>
				</a>
				<div class="footer-socials">
					{socialLinks.map((social) => social.qr ? (
						<div class="footer-social-item qr-item">
							<button type="button" class="qr-trigger" aria-label={social.label} aria-expanded="false" title={social.label}>
								<svg viewBox="0 0 24 24" width="20" height="20" role="img" aria-label={social.label} preserveAspectRatio="xMidYMid meet">
									<path fill="currentColor" d={social.icon.path} />
								</svg>
							</button>
							<div class="qr-preview">
								<Image src={social.qr} alt={`${social.label}二维码`} />
							</div>
						</div>
					) : (
							<a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}>
								<svg viewBox="0 0 24 24" width="20" height="20" role="img" aria-label={social.label} preserveAspectRatio="xMidYMid meet">
									<path fill="currentColor" d={social.icon.path} />
								</svg>
							</a>
						))}
				</div>
			</div>
			<div class="footer-bottom">
				<span>© 2026 硅基游民 Lucas</span>
				<div><a href="/privacy/">隐私政策</a><span>粤ICP备2026161121号-1</span></div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, "Noto Sans SC", sans-serif;
		color: #1d1d1f;
		background: #fff;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		--ink: #1d1d1f;
		--slate: #707070;
		--steel: #86868b;
		--line: #d6d6d6;
		--blue: #0066cc;
		--mist: #f5f5f7;
	}
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; }
	a { color: inherit; text-decoration: none; }
	button { color: inherit; font: inherit; }
	.site-header { position: fixed; z-index: 5; inset: 0 0 auto; height: 64px; padding: 0 7.2%; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.88); border-bottom: 1px solid rgba(214,214,214,.7); backdrop-filter: blur(20px); }
	.identity { display: inline-flex; align-items: center; gap: 11px; }
	.avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
	.site-header .identity strong { font-size: 16px; font-weight: 600; }
	.primary-nav { display: flex; height: 100%; align-items: center; gap: 30px; }
	.primary-nav > a, .primary-nav > .collections-dropdown > a { min-height: 100%; display: inline-flex; align-items: center; border: 0; background: transparent; padding: 0; color: rgba(29,29,31,.82); font-size: 16px; line-height: 1; cursor: pointer; }
	.primary-nav > a:hover, .primary-nav > .collections-dropdown > a:hover, .primary-nav a.active { color: var(--blue); }
	.collections-dropdown { position: relative; height: 100%; display: flex; align-items: center; }
	.collections-menu { position: absolute; z-index: 9; top: 100%; left: 50%; width: 208px; padding: 7px 0; transform: translate(-50%, 6px); border: 1px solid #e6e6e8; background: #fff; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .16s ease, transform .16s ease, visibility .16s; }
	.collections-dropdown:hover .collections-menu, .collections-dropdown:focus-within .collections-menu { transform: translate(-50%, 0); opacity: 1; visibility: visible; pointer-events: auto; }
	.collections-menu a { display: block; min-height: 0; padding: 11px 16px; color: var(--ink); font-size: 16px; line-height: 1.35; white-space: nowrap; }
	.collections-menu a:hover { color: var(--blue); background: #f5f5f7; }
	.menu-toggle { display: none; }
	.site-footer { background: #1d1d1f; color: #f5f5f7; padding: 30px 7.2% 18px; }
	.footer-main { min-height: 79px; display: flex; align-items: center; justify-content: space-between; gap: 25px; }
	.footer-identity .avatar { width: 32px; height: 32px; }
	.footer-identity > span { display: grid; gap: 5px; }
	.footer-identity strong { color: #f5f5f7; font-size: 12px; }
	.footer-identity small { color: #a1a1a6; font-size: 11px; }
	.footer-socials { max-width: 400px; display: flex; flex-wrap: wrap; justify-content: end; gap: 6px; }
	.footer-social-item, .footer-socials > a { position: relative; flex: 0 0 34px; width: 34px; height: 34px; display: grid; place-items: center; }
	.qr-item::after { content: ""; position: absolute; z-index: 7; left: 0; bottom: 100%; width: 100%; height: 12px; }
	.footer-socials > a, .footer-socials button { display: grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 0; background: transparent; color: #c7c7cc; cursor: pointer; transition: color .2s; }
	.footer-socials svg { display: block; width: 20px; height: 20px; overflow: visible; }
	.footer-socials > a:hover, .footer-socials button:hover { color: #fff; }
	.qr-preview { position: absolute; z-index: 8; bottom: calc(100% + 10px); left: 50%; width: 156px; height: 156px; padding: 9px; transform: translate(-50%, 6px); border: 1px solid #d6d6d6; border-radius: 4px; background: #fff; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .16s ease, transform .16s ease, visibility .16s; }
	.qr-preview::after { content: ""; position: absolute; top: 100%; left: calc(50% - 6px); width: 10px; height: 10px; transform: translateY(-5px) rotate(45deg); border-right: 1px solid #d6d6d6; border-bottom: 1px solid #d6d6d6; background: #fff; }
	.qr-preview img { display: block; width: 100%; height: 100%; object-fit: contain; }
	.qr-item:hover .qr-preview, .qr-item:focus-within .qr-preview, .qr-item.open .qr-preview { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(-50%, 0); }
	.footer-bottom { color: #a1a1a6; font-size: 10px; }
	.footer-bottom a:hover { color: #fff; }
	.footer-bottom { border-top: 1px solid #3a3a3c; padding-top: 13px; display: flex; justify-content: space-between; gap: 15px; }
	.footer-bottom div { display: flex; gap: 18px; }
	.menu-toggle span { display: block; width: 17px; height: 1px; background: var(--ink); }
	@media (max-width: 700px) {
		.site-header { height: 60px; padding: 0 18px; }
		.avatar { width: 31px; height: 31px; }
		.site-header .identity strong { font-size: 16px; }
		.menu-toggle { width: 36px; height: 36px; padding: 9px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; border: 0; background: transparent; cursor: pointer; }
		.primary-nav { position: absolute; top: 59px; left: 0; right: 0; height: auto; padding: 0 22px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 20px; overflow: hidden; max-height: 0; background: #fafafc; border-bottom: 1px solid transparent; transition: max-height .22s ease, padding .22s ease; }
		.primary-nav.open { max-height: 370px; padding-top: 10px; padding-bottom: 12px; border-color: #e6e6e8; }
		.primary-nav > a, .primary-nav > .collections-dropdown > a { min-height: 0; display: flex; align-items: center; padding: 12px 0; line-height: 1.2; text-align: left; }
		.collections-dropdown { grid-column: 1 / -1; height: auto; display: grid; grid-template-columns: 1fr; }
		.collections-dropdown > a { grid-column: 1; }
		.collections-menu { position: static; width: auto; padding: 0 0 5px; transform: none; border: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12px; opacity: 1; visibility: visible; pointer-events: auto; transition: none; }
		.collections-menu a { padding: 9px 0; white-space: normal; }
		.site-footer { padding: 24px 22px 15px; }
		.footer-main { align-items: flex-start; flex-direction: column; gap: 20px; padding-bottom: 18px; }
		.footer-socials { max-width: 100%; justify-content: flex-start; gap: 5px; }
		.footer-social-item, .footer-socials > a { flex-basis: 32px; width: 32px; height: 32px; }
		.footer-socials > a, .footer-socials button { width: 32px; height: 32px; }
		.qr-preview { width: 136px; height: 136px; }
		.footer-bottom { font-size: 9px; }
		.footer-bottom div { gap: 12px; }
	}
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
	}
</style>

<script>
	const navigation = document.querySelector<HTMLElement>('#primary-nav');
	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	menuToggle?.addEventListener('click', () => {
		const open = menuToggle.getAttribute('aria-expanded') !== 'true';
		menuToggle.setAttribute('aria-expanded', String(open));
		navigation?.classList.toggle('open', open);
	});
	navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
		menuToggle?.setAttribute('aria-expanded', 'false');
		navigation.classList.remove('open');
	}));
	const touchMode = window.matchMedia('(hover: none)').matches;
	document.querySelectorAll<HTMLButtonElement>('.qr-trigger').forEach((button) => {
		const item = button.closest<HTMLElement>('.qr-item');
		button.addEventListener('click', () => {
			if (!touchMode || !item) return;
			const open = item.classList.toggle('open');
			button.setAttribute('aria-expanded', String(open));
		});
	});
	document.addEventListener('pointerdown', (event) => {
		if (!touchMode || (event.target as Element).closest('.qr-item')) return;
		document.querySelectorAll<HTMLElement>('.qr-item.open').forEach((item) => {
			item.classList.remove('open');
			item.querySelector('.qr-trigger')?.setAttribute('aria-expanded', 'false');
		});
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		document.querySelectorAll<HTMLElement>('.qr-item.open').forEach((item) => {
			item.classList.remove('open');
			item.querySelector('.qr-trigger')?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
